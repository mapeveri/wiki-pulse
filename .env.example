# ClickHouse connection (used by the sink and the metrics API)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=raw
CLICKHOUSE_MARTS_DB=marts

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=wikipulse-sink

# Wikimedia Pageviews API
# The API is public and requires no key, but Wikimedia asks for a descriptive
# User-Agent identifying the tool and a contact URL/email.
WIKIMEDIA_USER_AGENT=seo-marketing-analytics-platform/0.1 (https://github.com/your-user/seo-marketing-analytics-platform)

# Metrics API (comma-separated CORS origins)
API_CORS_ORIGINS=*
