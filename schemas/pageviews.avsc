{
  "type": "record",
  "name": "Pageview",
  "namespace": "com.wikipulse.events",
  "doc": "Daily Wikimedia pageview totals published to pageviews.raw.",
  "fields": [
    { "name": "project", "type": "string" },
    { "name": "article", "type": "string" },
    { "name": "access", "type": "string" },
    { "name": "agent", "type": "string" },
    { "name": "granularity", "type": "string" },
    { "name": "ts", "type": "string", "doc": "Event date formatted as YYYY-MM-DD." },
    { "name": "views", "type": "long" }
  ]
}
